<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1114"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Назад"
            android:backgroundTint="#00000000"
            android:textColor="#22D3EE" />

        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/bannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6EDF3"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/uidText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#22D3EE"
                android:typeface="monospace"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#7D8B96"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="СОДЕРЖИМОЕ"
            android:textColor="#7D8B96"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/recordsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button android:id="@+id/btnPass" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Провести проход" android:backgroundTint="#22D3EE" android:textColor="#04222A" />
        <Button android:id="@+id/btnRename" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Переименовать"
            android:backgroundTint="#161B20" android:textColor="#E6EDF3" />
        <Button android:id="@+id/btnWrite" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Записать текст на карту"
            android:backgroundTint="#161B20" android:textColor="#E6EDF3" />
        <Button android:id="@+id/btnDelete" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Удалить из базы"
            android:backgroundTint="#161B20" android:textColor="#EF4444" />
    </LinearLayout>
</ScrollView>
